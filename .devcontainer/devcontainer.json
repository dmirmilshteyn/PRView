{
  "name": "PRView",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/PRView",
  "forwardPorts": [9999],
  "portsAttributes": {
    "9999": {
      "label": "Next.js development server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode"
      ]
    }
  }
}
