{
  "name": "PRView",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/PRView",
  "initializeCommand": "sh .devcontainer/prepare-gh-auth.sh",
  "mounts": [
    "source=prview-codex-data,target=/root/.codex,type=volume",
    "source=${localWorkspaceFolder}/.devcontainer/gh-auth,target=/run/gh-auth,type=bind,readonly",
    "source=${localEnv:HOME}/.codex/auth.json,target=/root/.codex/auth.json,type=bind,readonly"
  ],
  "containerEnv": {
    "GH_CONFIG_DIR": "/run/gh-auth",
    "CODEX_HOME": "/root/.codex"
  },
  "forwardPorts": [9999],
  "portsAttributes": {
    "9999": {
      "label": "Next.js development server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bun install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "oven.bun-vscode"
      ]
    }
  }
}
