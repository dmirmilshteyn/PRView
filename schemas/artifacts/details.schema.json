{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prview.local/schemas/artifacts/details.schema.json",
  "title": "PRView Pull Request Details",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "number",
    "link",
    "title",
    "description",
    "repository",
    "author",
    "branch",
    "baseBranch",
    "status",
    "createdAt",
    "updatedAt",
    "reviewers",
    "assignees",
    "labels",
    "milestone",
    "draft",
    "mergeable",
    "reviewDecision",
    "filesChanged",
    "additions",
    "deletions",
    "commits",
    "checks"
  ],
  "properties": {
    "number": { "type": "integer", "minimum": 1 },
    "link": { "type": "string", "format": "uri" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "repository": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["needs-review", "in-progress", "ready-to-merge"] },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "reviewers": { "$ref": "#/$defs/stringList" },
    "assignees": { "$ref": "#/$defs/stringList" },
    "labels": { "$ref": "#/$defs/stringList" },
    "milestone": { "type": "string", "minLength": 1 },
    "draft": { "type": "boolean" },
    "mergeable": { "type": "boolean" },
    "reviewDecision": { "type": "string", "enum": ["Awaiting review", "Changes requested", "In review", "Approved"] },
    "filesChanged": { "type": "integer", "minimum": 0 },
    "additions": { "type": "integer", "minimum": 0 },
    "deletions": { "type": "integer", "minimum": 0 },
    "commits": { "type": "integer", "minimum": 0 },
    "checks": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
