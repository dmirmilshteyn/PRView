{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prview.local/schemas/artifacts/diff.schema.json",
  "title": "PRView Pull Request Diff",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileDiff" }
    }
  },
  "$defs": {
    "fileDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "additions", "deletions", "hunks"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["added", "modified", "deleted", "renamed"] },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "hunks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["header", "lines"],
            "properties": {
              "header": { "type": "string", "minLength": 1 },
              "lines": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
